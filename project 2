  function trapFocus(modalEl) {
    const focusableEls = modalEl.querySelectorAll('a[href], button, textarea, input, select');
    if(focusableEls.length === 0) return;
    const first = focusableEls[0], last = focusableEls[focusableEls.length - 1];

    modalEl.addEventListener('keydown', function(e) {
      if (e.key !== 'Tab') return;
      if (e.shiftKey) { if (document.activeElement === first) { last.focus(); e.preventDefault(); } } 
      else { if (document.activeElement === last) { first.focus(); e.preventDefault(); } }
    });
    setTimeout(() => first.focus(), 50);
  }

  // --- CAROUSEL SYSTEM ---
  function makeScrollableDraggable(ele, trackId, isVertical = false) {
    if (ele.dataset.dragAttached) return; // Prevent attaching multiple times
    let pos = { top: 0, left: 0, x: 0, y: 0 }, isDragging = false;
    const mouseDownHandler = (e) => {
      isDragging = true; ele.style.cursor = 'grabbing'; ele.style.userSelect = 'none';
      pos = { left: ele.scrollLeft, top: ele.scrollTop, x: e.clientX, y: e.clientY };
      document.addEventListener('mousemove', mouseMoveHandler);
      document.addEventListener('mouseup', mouseUpHandler);
      if (carouselIntervals[trackId]) clearInterval(carouselIntervals[trackId]); 
    };
    const mouseMoveHandler = (e) => {
      if (!isDragging) return;
      if (isVertical) ele.scrollTop = pos.top - (e.clientY - pos.y);
      else ele.scrollLeft = pos.left - (e.clientX - pos.x);
    };
    const mouseUpHandler = () => {
      isDragging = false; ele.style.cursor = 'grab'; ele.style.removeProperty('user-select');
      document.removeEventListener('mousemove', mouseMoveHandler);
      document.removeEventListener('mouseup', mouseUpHandler);
      if(trackId && !isVertical) startAutoPlay(trackId, 4000); 
    };
    ele.addEventListener('mousedown', mouseDownHandler);
    ele.style.cursor = 'grab';
    ele.addEventListener('touchstart', () => { if (carouselIntervals[trackId]) clearInterval(carouselIntervals[trackId]); }, {passive: true});
    ele.addEventListener('touchend', () => { if(trackId && !isVertical) startAutoPlay(trackId, 4000); }, {passive: true});
    ele.dataset.dragAttached = 'true';
  }

  function startAutoPlay(trackId, intervalMs) {
    clearInterval(carouselIntervals[trackId]);
    carouselIntervals[trackId] = setInterval(() => {
      const track = document.getElementById(trackId);
      if(!track || track.clientWidth === 0) return; 
      const maxScroll = track.scrollWidth - track.clientWidth;
      if (track.scrollLeft >= maxScroll - 10) track.scrollTo({ left: 0, behavior: 'smooth' }); 
      else track.scrollBy({ left: track.clientWidth, behavior: 'smooth' }); 
    }, intervalMs);
  }

  function setupCarousel(trackId, dotsId, imagesArray) {
    const track = document.getElementById(trackId), dots = document.getElementById(dotsId);
    const validImages = imagesArray.filter(link => link.trim() !== "");
    if (validImages.length === 0) return;

    let html = '', dotsHtml = '';
    validImages.forEach((imgLink, i) => {
      html += `<img src="${imgLink}" class="carousel-img" alt="Carousel Image ${i+1}" draggable="false" loading="lazy"/>`;
      dotsHtml += `<span class="dot" onclick="document.getElementById('${trackId}').scrollTo({ left: document.getElementById('${trackId}').clientWidth * ${i}, behavior: 'smooth' }); App.startAutoPlay('${trackId}', 4000);"></span>`;
    });
    
    track.innerHTML = html; dots.innerHTML = dotsHtml;
    track.addEventListener('scroll', () => {
      if(track.clientWidth === 0) return;
      const index = Math.round(track.scrollLeft / track.clientWidth);
      document.querySelectorAll(`#${dotsId} .dot`).forEach((d, i) => d.classList.toggle('active', i === index));
    });

    makeScrollableDraggable(track, trackId, false);
    if (document.querySelector(`#${dotsId} .dot`)) document.querySelector(`#${dotsId} .dot`).classList.add('active');
    startAutoPlay(trackId, 4000); 
  }

