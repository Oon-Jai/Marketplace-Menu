      status.style.color = "#94a3b8"; status.innerText = "Submitting..."; submitBtn.disabled = true;

      fetch(WEB_APP_URL, { method: 'POST', body: new FormData(this), mode: 'no-cors' })
      .then(() => {
        status.style.color = "#4ade80"; status.innerText = "✓ Sent successfully!";
        App.clearForm(); submitBtn.disabled = false;
      })
      .catch(error => {
        status.style.color = "#f87171"; status.innerText = "Error submitting message. Please try again.";
        submitBtn.disabled = false;
      });
    });
  }

  // Helper used internally to render HTML (Menu Items)
  function renderProductsGrid() {
    const container = document.getElementById('productsGrid'); container.innerHTML = '';
    menuData[currentCategory].forEach(item => {
      const count = getItemCountInCart(item.id);
      const card = document.createElement('div'); card.className = 'product-card';
      const countHtml = count > 0 ? `<span class="item-count-text">×${count}</span>` : '';
      const actionBtn = item.isCustom ? `<button class="add-btn" onclick="App.openCustomModal('${currentCategory}', '${item.id}')">Customize</button>`
                                      : `<button class="add-btn" onclick="App.addMenuItemToCart('${currentCategory}', '${item.id}')">Add +</button>`;
      
      // Determine Thumbnail
      const imageList = item.images && item.images.length > 0 ? item.images : defaultDummyImages;
      const thumbnailSrc = imageList[0];
      const imageHtml = `<img src="${thumbnailSrc}" class="product-image" alt="${item.name}" loading="lazy" onclick="App.openGallery('${currentCategory}', '${item.id}')" aria-label="View images for ${item.name}">`;

      card.innerHTML = `
        <div style="display: flex; gap: 12px; align-items: center; width: 100%;">
          ${imageHtml}
          <div class="product-info">
            <div class="product-name">${item.name}</div>
            <div class="product-desc">${item.desc}</div>
          </div>
        </div>
        <div class="product-action">
          <span class="price">${formatKip(item.price)}</span>
          <div class="btn-wrapper">${countHtml}${actionBtn}</div>
        </div>
      `;
      container.appendChild(card);
    });
  }

  // --- PUBLIC API / METHODS ---
  return {
    startAutoPlay,
    
    toggleMobileMenu: function() { 
      const menu = document.getElementById('mobileMenu');
      const btn = document.querySelector('.hamburger');
      menu.classList.toggle('active');
      btn.setAttribute('aria-expanded', menu.classList.contains('active'));
    },

    switchMainTab: function(tabId) {
      document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
      document.getElementById('tab-' + tabId).classList.add('active');

      document.querySelectorAll('.nav-tab').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      document.querySelectorAll(`[data-tab="${tabId}"]`).forEach(btn => {
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
      });

      const mobileMenu = document.getElementById('mobileMenu');
      mobileMenu.classList.remove('active');
      document.querySelector('.hamburger').setAttribute('aria-expanded', 'false');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    },

    scrollCarousel: function(trackId, dir) {
      const track = document.getElementById(trackId);
      track.scrollBy({ left: track.clientWidth * dir, behavior: 'smooth' });
      startAutoPlay(trackId, 4000); 
    },

    clearForm: function() {
      document.getElementById('customForm').reset();
      document.getElementById("device_token").value = localStorage.getItem("oonjai_user_id");
      document.getElementById('statusMsg').innerText = "";
      const wc = document.getElementById('wordCounter');
      wc.innerText = "0 / 20-30 words"; wc.style.color = "#64748b";
    },

    switchCategory: function(catKey) {
      currentCategory = catKey;
      document.querySelectorAll('.cat-btn').forEach(btn => btn.classList.toggle('active', btn.dataset.category === catKey));
      const titleMap = { burgers: 'Burgers', sandwiches: 'Sandwiches', texmex: 'Tex-Mexican', pasta: 'Pasta', bowl: 'Build Your Bowl', smoothies: 'Smoothies', refreshers: 'Refreshers', wellness: 'Wellness Drinks' };
      document.getElementById('categoryTitle').innerText = titleMap[catKey];
      
      renderProductsGrid();
      const scrollTarget = window.innerWidth < 768 ? document.getElementById('contentLayout') : document.getElementById('mainContent');
      if (scrollTarget && typeof scrollTarget.scrollIntoView === 'function') scrollTarget.scrollIntoView({behavior: 'smooth', block: 'start'});
    },

    addMenuItemToCart: function(category, itemId) {
      const item = menuData[category].find(i => i.id === itemId);
      if (item) { cart.push({ id: item.id, name: item.name, price: item.price, subtext: '' }); this._reRenderStore(); }
    },

    removeFromCart: function(index) { cart.splice(index, 1); this._reRenderStore(); },
    
    _reRenderStore: function() {
      renderProductsGrid();
      const container = document.getElementById('cartItems'), countEl = document.getElementById('cartCount'), totalEl = document.getElementById('totalPrice');
      let total = cart.reduce((sum, item) => sum + item.price, 0);
      countEl.innerText = `(${cart.length} item${cart.length === 1 ? '' : 's'})`;

      if (cart.length === 0) {
        container.innerHTML = `<p class="empty-cart-msg">Your basket is empty.</p>`; totalEl.innerText = '0 Kip';
      } else {
        container.innerHTML = cart.map((item, idx) => `
          <div class="cart-item">
            <div><div class="cart-item-name">${item.name}</div>${item.subtext ? `<div class="cart-item-sub">${item.subtext}</div>` : ''}</div>
            <div style="display: flex; align-items: center;"><span class="cart-item-price">${formatKip(item.price)}</span><button class="remove-btn" onclick="App.removeFromCart(${idx})">Remove</button></div>
          </div>
        `).join('');
        totalEl.innerText = formatKip(total);
      }
    },

    openCustomModal: function(catKey, itemId) {
      const item = menuData[catKey].find(i => i.id === itemId);
      if (!item) return;

      currentActiveCustomItem = { ...item };
      document.getElementById('modalTitle').innerText = item.name;
      const refBox = document.getElementById('refresherSweetenerBox'), bldBox = document.getElementById('standardBuilderBox'), welBox = document.getElementById('wellnessChoiceBox');

      if (item.isRefresher) {
        refBox.style.display = 'block'; bldBox.style.display = 'none'; welBox.style.display = 'none';
        document.querySelector('input[name="refresherSweetener"][value="Honey"]').checked = true;
      } else {
        refBox.style.display = 'none'; bldBox.style.display = 'block';
        if (item.needsWellnessChoice) {
          welBox.style.display = 'block';
          document.getElementById('wellnessContainer').innerHTML = commonChoices.wellnessDrinks.map((drink, idx) => `<label class="option-label"><input type="radio" name="custWellness" value="${drink}" ${idx === 0 ? 'checked' : ''}> ${drink}</label>`).join('');
        } else welBox.style.display = 'none';

        document.getElementById('modalRulesInfo').innerText = `Included: Up to ${item.maxSauces} Sauce(s), ${item.maxVeggies} Veggie(s), and ${item.maxProteins} Protein(s).\n(Extra Veggies or Proteins: +7,000 Kip each)`;
        
        const genChoices = (arr, name) => arr.map(val => `<label class="option-label"><input type="checkbox" name="${name}" value="${val}" onchange="App.enforceLimit(this, '${name}', currentActiveCustomItem.max${name.replace('cust', '')}s)"> ${val}</label>`).join('');
        document.getElementById('saucesContainer').innerHTML = genChoices(commonChoices.sauces, 'custSauce');
        document.getElementById('veggiesContainer').innerHTML = genChoices(commonChoices.veggies, 'custVeggie');
        document.getElementById('proteinsContainer').innerHTML = genChoices(item.specificProteins ? commonChoices[item.specificProteins] : commonChoices.proteins, 'custProtein');
      }
      
      const modal = document.getElementById('customModal');
      modal.classList.add('active');
      trapFocus(modal);
    },

    closeCustomModal: function() { document.getElementById('customModal').classList.remove('active'); currentActiveCustomItem = null; },
    
    // -- Image Gallery Logic --
    openGallery: function(catKey, itemId) {
      const item = menuData[catKey].find(i => i.id === itemId);
      if (!item) return;
      const imageList = item.images && item.images.length > 0 ? item.images : defaultDummyImages;
      
      setupCarousel('galleryCarouselTrack', 'galleryCarouselDots', imageList);
      
      const modal = document.getElementById('galleryModal');
      modal.classList.add('active');
      trapFocus(modal);
    },
    closeGallery: function() { 
      document.getElementById('galleryModal').classList.remove('active'); 
      if(carouselIntervals['galleryCarouselTrack']) clearInterval(carouselIntervals['galleryCarouselTrack']);
    },
    
    enforceLimit: function(checkbox, groupName, maxAllowed) {
      if (groupName === 'custSauce') {
        if (document.querySelectorAll(`input[name="${groupName}"]:checked`).length > maxAllowed) {
          checkbox.checked = false;
          this.triggerAlert(`Limit reached! You can select up to ${maxAllowed} Sauce(s) for this section.`, 'Limit Reached');
        }
      }
    },

    addCustomItemToCart: async function() {
      if (!currentActiveCustomItem) return;
      if (currentActiveCustomItem.isRefresher) {
        const sw = document.querySelector('input[name="refresherSweetener"]:checked').value;
        cart.push({ id: currentActiveCustomItem.id, name: currentActiveCustomItem.name, price: currentActiveCustomItem.price, subtext: `Sweetened by: ${sw}` });
        this._reRenderStore(); this.closeCustomModal(); return;
      }

      const getVals = (name) => Array.from(document.querySelectorAll(`input[name="${name}"]:checked`)).map(cb => cb.value);
      const sauces = getVals('custSauce'), veggies = getVals('custVeggie'), proteins = getVals('custProtein');
      const maxS = currentActiveCustomItem.maxSauces, maxV = currentActiveCustomItem.maxVeggies, maxP = currentActiveCustomItem.maxProteins;

      if (!sauces.length && !veggies.length && !proteins.length) return this.triggerAlert("Please select at least one item to build your option.", "Selection Required");

      const extV = Math.max(0, veggies.length - maxV), extP = Math.max(0, proteins.length - maxP);
      const totExt = extV + extP, totExtCost = totExt * EXTRA_ADDON_PRICE;
      let warnings = [];

      if (sauces.length < maxS || veggies.length < maxV || proteins.length < maxP) {
        let short = [];
        if (sauces.length < maxS) short.push(`Sauces: ${sauces.length} / ${maxS}`);
        if (veggies.length < maxV) short.push(`Veggies: ${veggies.length} / ${maxV}`);
        if (proteins.length < maxP) short.push(`Proteins: ${proteins.length} / ${maxP}`);
        warnings.push(`You still have unused included choices:\n` + short.join('\n'));
      }
      if (totExt > 0) {
        let extra = [];
        if (extV > 0) extra.push(`Extra Veggies: +${extV} (${formatKip(extV * EXTRA_ADDON_PRICE)})`);
        if (extP > 0) extra.push(`Extra Proteins: +${extP} (${formatKip(extP * EXTRA_ADDON_PRICE)})`);
        warnings.push(`Additional Add-ons selected:\n` + extra.join('\n') + `\nTotal Extra: +${formatKip(totExtCost)}`);
      }

      if (warnings.length > 0) {
        const proceed = await new Promise(resolve => this.triggerConfirm(warnings.join('\n\n') + `\n\nAre you sure you want to proceed and add to order?`, 'Customize Confirmation', resolve));
        if (!proceed) return;
      }

      let subParts = [];
      if (currentActiveCustomItem.needsWellnessChoice) subParts.push(`Drink: ${document.querySelector('input[name="custWellness"]:checked').value}`);
      if (sauces.length) subParts.push(`Sauces: ${sauces.join(', ')}`);
      if (veggies.length) subParts.push(`Veggies: ${veggies.join(', ')}`);
      if (proteins.length) subParts.push(`Proteins: ${proteins.join(', ')}`);
      if (totExt > 0) subParts.push(`Add-ons: +${totExt} item(s) (+${formatKip(totExtCost)})`);

      cart.push({ id: currentActiveCustomItem.id, name: currentActiveCustomItem.name, price: currentActiveCustomItem.price + totExtCost, subtext: subParts.join(' | ') });
      this._reRenderStore(); this.closeCustomModal();
    },

    clearOrderTypeError: function() {
      document.getElementById('orderOptionsBox').classList.remove('error-highlight');
      document.getElementById('orderTypeErrorMsg').style.display = 'none';
    },

    checkoutWA: function() {
      const msg = this._buildOrderMsg();
      if (msg) window.open(`https://wa.me/${PHONE_NUMBER}?text=${encodeURIComponent(msg)}`, '_blank');
    },

    checkoutMessenger: function() {
      const msg = this._buildOrderMsg();
      if (!msg) return;
      navigator.clipboard.writeText(msg).then(() => {
        this.triggerConfirm("Your order details have been successfully copied.\n\nWhen Messenger opens, just PASTE the text into the chat to send your order.", "Order Copied! 📋", (proceed) => {
          if (proceed) window.open(`https://m.me/${MESSENGER_USERNAME}`, '_blank');
        }, true);
      }).catch(() => this.triggerAlert("We couldn't copy the text automatically. You can still proceed to Messenger, or use WhatsApp for an automatic message.", "Notice"));
    },

    _buildOrderMsg: function() {
      if (cart.length === 0) { this.triggerAlert("Your basket is empty! Please add items before ordering.", "Empty Basket"); return null; }
      const type = document.querySelector('input[name="orderType"]:checked');
      if (!type) {
        document.getElementById('orderOptionsBox').classList.add('error-highlight'); document.getElementById('orderTypeErrorMsg').style.display = 'block';
        document.getElementById('orderOptionsBox').scrollIntoView({ behavior: 'smooth', block: 'center' });
        this.triggerAlert("⚠️ Please select either Dine-In or Pick-Up before submitting your order!", "Action Required"); return null;
      }
      let msg = `✦ *OON JAI ORDER* ✦\n*Type: ${type.value}*\n\n*Items Ordered:*\n`;
      cart.forEach((item, index) => { msg += `${index + 1}. *${item.name}* - ${formatKip(item.price)}\n` + (item.subtext ? `   _${item.subtext}_\n` : ''); });
      msg += `\n*Total: ${formatKip(cart.reduce((sum, item) => sum + item.price, 0))}*\n\n👉Note: Please send your payment receipt to process this order.\n`;
      return msg;
    },

    // Modal Prompts
    triggerAlert: function(message, title) {
      document.getElementById('notifTitle').innerText = title; document.getElementById('notifMessage').innerText = message;
      document.getElementById('notifAlertAction').style.display = 'block'; document.getElementById('notifConfirmActions').style.display = 'none';
      const m = document.getElementById('notificationModal'); m.classList.add('active'); trapFocus(m);
    },
    triggerConfirm: function(message, title, callback, isMessenger = false) {
      document.getElementById('notifTitle').innerText = title; document.getElementById('notifMessage').innerText = message;
      document.getElementById('notifAlertAction').style.display = 'none'; document.getElementById('notifConfirmActions').style.display = 'flex';
      const m = document.getElementById('notificationModal'); m.classList.add('active'); trapFocus(m);
      
      const btnProceed = document.getElementById('btnNotifProceed');
      btnProceed.innerText = isMessenger ? "Open Messenger" : "Proceed";
      
      document.getElementById('btnNotifCancel').onclick = () => { this.closeNotification(); callback(false); };
      btnProceed.onclick = () => { this.closeNotification(); btnProceed.innerText = "Proceed"; callback(true); };
    },
    closeNotification: function() { document.getElementById('notificationModal').classList.remove('active'); }
  };
})();
</script>
